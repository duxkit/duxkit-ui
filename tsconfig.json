{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "duxkit-ai": ["./dist/duxkit-ai"],
      "duxkit-ai/*": ["./dist/duxkit-ai/*"],
      "@duxkit/ui": ["./projects/ui/src/index.ts"],
      "@duxkit/ui/helm/button": ["./projects/ui/helm/button/src/index.ts"],
      "@duxkit/ui/helm/command": ["./projects/ui/helm/command/src/index.ts"],
      "@duxkit/ui/helm/dialog": ["./projects/ui/helm/dialog/src/index.ts"],
      "@duxkit/ui/helm/icon": ["./projects/ui/helm/icon/src/index.ts"],
      "@duxkit/ui/helm/input": ["./projects/ui/helm/input/src/index.ts"],
      "@duxkit/ui/helm/input-group": ["./projects/ui/helm/input-group/src/index.ts"],
      "@duxkit/ui/helm/navigation-menu": [
        "./projects/ui/helm/navigation-menu/src/index.ts"
      ],
      "@duxkit/ui/helm/tabs": ["./projects/ui/helm/tabs/src/index.ts"],
      "@duxkit/ui/helm/textarea": ["./projects/ui/helm/textarea/src/index.ts"],
      "@duxkit/ui/helm/utils": ["./projects/ui/helm/utils/src/index.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/duxkit-ai/tsconfig.lib.json"
    },
    {
      "path": "./projects/duxkit-ai/tsconfig.spec.json"
    },
    {
      "path": "./projects/duxkit-ai/tsconfig.storybook.json"
    },
    {
      "path": "./projects/playground/tsconfig.app.json"
    },
    {
      "path": "./projects/playground/tsconfig.spec.json"
    },
    {
      "path": "./projects/www/tsconfig.app.json"
    },
    {
      "path": "./projects/ui/tsconfig.lib.json"
    }
  ]
}
