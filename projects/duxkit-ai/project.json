{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "duxkit-ai",
  "projectType": "library",
  "sourceRoot": "projects/duxkit-ai/src",
  "prefix": "ai",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "configurations": {
        "production": {
          "tsConfig": "projects/duxkit-ai/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "projects/duxkit-ai/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "projects/duxkit-ai/tsconfig.spec.json"
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "browserTarget": "playground:build:development",
        "configDir": ".storybook",
        "tsConfig": "projects/duxkit-ai/tsconfig.storybook.json",
        "styles": [
          "projects/playground/src/styles.scss"
        ],
        "port": 6006,
        "compodoc": false,
        "experimentalZoneless": true
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "options": {
        "browserTarget": "playground:build:development",
        "configDir": ".storybook",
        "tsConfig": "projects/duxkit-ai/tsconfig.storybook.json",
        "styles": [
          "projects/playground/src/styles.scss"
        ],
        "outputDir": "dist/storybook/duxkit-ai",
        "compodoc": false,
        "experimentalZoneless": true
      }
    }
  }
}