{
  "name": "www",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "projects/www/src",
  "tags": [],
  "implicitDependencies": [
    "duxkit-ai",
    "ui"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/www",
        "browser": "projects/www/src/main.ts",
        "server": "projects/www/src/main.server.ts",
        "tsConfig": "projects/www/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "outputMode": "static",
        "assets": [
          {
            "glob": "**/*",
            "input": "projects/www/public"
          }
        ],
        "styles": [
          "projects/www/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "www:build:production"
        },
        "development": {
          "buildTarget": "www:build:development"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "www:build",
        "staticFilePath": "dist/www/browser",
        "spa": true
      }
    }
  }
}
