{
  "name": "duxkit-ai-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve www",
    "start:www": "nx serve www",
    "storybook": "scripts/with-node.sh nx run duxkit-ai:storybook",
    "build:storybook": "scripts/with-node.sh nx run duxkit-ai:build-storybook",
    "build": "pnpm build:lib && pnpm build:cli && pnpm build:www",
    "build:cli": "nx build cli",
    "build:lib": "nx build duxkit-ai",
    "build:www": "CI=1 nx build www --progress=false",
    "smoke:cli": "node projects/cli/scripts/smoke-package.mjs",
    "cli:sync-templates": "node projects/cli/scripts/sync-templates.mjs",
    "cli:check-templates": "node projects/cli/scripts/sync-templates.mjs --check",
    "docs:generate-metadata": "node scripts/generate-docs-api-metadata.mjs",
    "check:package-entrypoints": "node scripts/check-package-entrypoints.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:conventions": "node scripts/check-workspace-conventions.mjs",
    "watch": "nx build duxkit-ai --watch --configuration development",
    "test": "nx run-many -t test",
    "test:cli": "nx test cli",
    "test:ci": "CI=1 nx run-many -t test -- --watch=false"
  },
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@nx/angular": "23.1.0-beta.4",
      "@nx/devkit": "23.1.0-beta.4",
      "@nx/js": "23.1.0-beta.4",
      "@nx/workspace": "23.1.0-beta.4",
      "nx": "23.1.0-beta.4",
      "@babel/core": "7.29.7",
      "esbuild": "0.27.7",
      "http-proxy-middleware": "3.0.7",
      "postcss": "8.5.15",
      "uuid": "11.1.1",
      "webpack-dev-server": "5.2.5",
      "webpack": "5.106.2"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25 || >=22.22.3 <23 || >=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/angular": "^2.0.208",
    "@angular/cdk": "22.0.2",
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/platform-browser": "^22.0.4",
    "@angular/router": "^22.0.4",
    "@ng-icons/core": "^33.3.0",
    "@ng-icons/lucide": "33.3.0",
    "@spartan-ng/brain": "1.0.2",
    "ai": "^6.0.207",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.4",
    "@angular-devkit/core": "22.0.4",
    "@angular-devkit/schematics": "^22.0.4",
    "@angular/animations": "^22.0.4",
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@angular/platform-browser-dynamic": "^22.0.4",
    "@angular/platform-server": "^22.0.4",
    "@angular/ssr": "^22.0.4",
    "@nx/angular": "23.1.0-beta.4",
    "@nx/workspace": "23.1.0-beta.4",
    "@schematics/angular": "^22.0.4",
    "@spartan-ng/cli": "1.0.2",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/angular": "10.4.6",
    "@tailwindcss/postcss": "^4.3.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "nx": "23.1.0-beta.4",
    "prettier": "^3.8.1",
    "storybook": "10.4.6",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "webpack": "5.106.2",
    "zone.js": "~0.16.2"
  }
}
