{
  "name": "angular-ai-sdk-kit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:playground": "pnpm build:lib && concurrently -k -n api,ng -c cyan,green \"pnpm run server:playground\" \"ng serve playground\"",
    "server:playground": "node projects/playground/server/server.mjs",
    "storybook": "ng run ai-sdk-angular:storybook",
    "build:storybook": "ng run ai-sdk-angular:build-storybook",
    "build": "ng build",
    "build:lib": "ng build ai-sdk-angular",
    "build:playground": "pnpm build:lib && CI=1 ng build playground --progress=false",
    "watch": "ng build ai-sdk-angular --watch --configuration development",
    "test": "ng test",
    "test:ci": "CI=1 ng test --watch=false"
  },
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.15.0 <25 || >=22.22.3 <23 || >=26.0.0"
  },
  "dependencies": {
    "@ai-sdk/angular": "^2.0.208",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ng-icons/core": "^31.4.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "0.0.1-alpha.718",
    "ai": "^6.0.207",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.4",
    "@angular/animations": "^22.0.3",
    "@angular/build": "^22.0.2",
    "@angular/cli": "^22.0.2",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.3",
    "@spartan-ng/cli": "0.0.1-alpha.718",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/angular": "10.4.6",
    "@tailwindcss/postcss": "^4.3.1",
    "concurrently": "^10.0.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "storybook": "10.4.6",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "zone.js": "~0.16.2"
  }
}
